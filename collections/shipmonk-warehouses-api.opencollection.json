{
  "opencollection": "1.0.0",
  "info": {
    "name": "ShipMonk Warehouses API",
    "version": "v1.024"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Warehouses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve List of Warehouses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shipmonk.com/v1/integrations/warehouses",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "1-based page number to return. Defaults to 1."
              },
              {
                "name": "pageSize",
                "value": "10",
                "type": "query",
                "description": "Number of results per page. Defaults to a server-configured value; check the response metadata for the effective size."
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Field to sort warehouses by (e.g., id, name, identifier). See the schema for allowed values."
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "Sort direction: ASC (ascending) or DESC (descending)."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Api-Key",
              "value": "{{Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Returns all enabled warehouses for the account associated with your API key. Warehouse IDs and identifiers are required across various endpoints and can be included in query parameters to filter results."
        }
      ]
    }
  ],
  "bundled": true
}